# Startup guards enforce for ANY value not in the recognized development set
# (development/dev/test/testing/local) — prod, staging, and misspellings are
# all treated as production (fail-closed).
ENVIRONMENT=production

# Start production rollouts in compatibility mode. Change only after the
# documented rollout gates pass.
LIFF_STRICT_MODE=false
COOKIE_AUTH_MODE=bearer

# DEV_AUTH_BYPASS must stay absent/false in production — enforced at startup
# (enabling it here disables admin auth entirely; see backend/app/api/deps.py).
# DEV_AUTH_BYPASS=false

# REQUIRED in production (enforced at startup — see docs/remediation/migration-controls.md
# "P0.1 production startup guards"): at least 32 characters and not a placeholder
# value like the one below. Helper: Generate a secret key using `openssl rand -hex 32`
SECRET_KEY=change_this_to_a_secure_random_string
# REQUIRED in production (enforced at startup): must be a valid Fernet key, not blank.
# Helper: Generate a Fernet key using `python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"`
ENCRYPTION_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Production frontend origin
BACKEND_CORS_ORIGINS=["https://your-frontend.example.com"]

# Database (PostgreSQL)
DATABASE_URL=postgresql+asyncpg://postgres:password@db.example.com:5432/skn_app_db

# Redis
REDIS_URL=redis://default:password@redis.example.com:6379/0

# LINE Messaging API
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=

# LINE Login
# REQUIRED in production (enforced at startup): must be set to your LINE Login
# channel ID — blank/whitespace fails LIFF ID-token verification closed (HTTP 503).
LINE_LOGIN_CHANNEL_ID=

# Public backend URL used for webhook/media links
SERVER_BASE_URL=https://api.example.com

# Admin frontend URL (used for Telegram notification links)
ADMIN_URL=https://your-frontend.example.com

# Seed admin helper
ADMIN_DEFAULT_PASSWORD=change_this_for_prod

# SLA thresholds
SLA_MAX_FRT_SECONDS=120
SLA_MAX_RESOLUTION_SECONDS=1800
SLA_MAX_QUEUE_WAIT_SECONDS=300
SLA_ALERT_TELEGRAM_ENABLED=false
