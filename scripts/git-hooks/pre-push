#!/bin/sh
# Block direct pushes to main — all changes land via PR.
# Bypass (with reason) only: git push --no-verify
while read -r local_ref local_oid remote_ref remote_oid || [ -n "$local_ref" ]; do
  case "$remote_ref" in
    refs/heads/main|refs/heads/master)
      echo "BLOCKED: direct push to ${remote_ref} (${local_ref} ${local_oid})" >&2
      echo "Open a PR instead: git checkout -b <feat/...> && git push -u origin <feat/...>" >&2
      exit 1
      ;;
  esac
done
exit 0
